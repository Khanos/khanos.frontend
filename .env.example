# Public URL only: credentials, query strings and fragments are forbidden.
# Supply this in both build and runtime environments. HTTPS in production.
PUBLIC_BACKEND_API_URL=https://khanos-backend.herokuapp.com/api/
# Server-only secrets for /url and /admin/blog. Never use PUBLIC_ names.
# Owner username/password are separate from the backend bearer token.
URL_ADMIN_USERNAME=
URL_ADMIN_PASSWORD=
OWNER_API_TOKEN=
BACKEND_TIMEOUT_MS=8000
# Server-only Vercel Firewall SDK rule IDs. Configure enforcing rules first.
# Missing rules/platform identity or provider errors fail closed in production.
# Example staging budgets; see docs/short-url-security.md before deployment.
OWNER_RATE_LIMIT_ID=owner-safety
OWNER_AGGREGATE_RATE_LIMIT_ID=owner-emergency
OWNER_FAILURE_RATE_LIMIT_ID=owner-failures
SHORT_URL_RATE_LIMIT_ID=short-url-resolver
# Independent server-only secret used by the SDK to salt counting keys.
# Random 32-256 printable non-space ASCII; do not reuse any owner credential.
RATE_LIMIT_SECRET=
# Server-only token from a PUBLIC Vercel Blob store connected to this frontend.
# Never prefix with PUBLIC_. Public uploaded images are accessible by their URL.
BLOB_READ_WRITE_TOKEN=

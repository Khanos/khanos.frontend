# Public URL only: credentials, query strings and fragments are forbidden.
# Supply this in both build and runtime environments. HTTPS in production.
PUBLIC_BACKEND_API_URL=https://khanos-backend.herokuapp.com/api/
# Server-only secrets for /url and /admin/blog. Never use PUBLIC_ names.
# Owner username/password are separate from the backend bearer token.
URL_ADMIN_USERNAME=
URL_ADMIN_PASSWORD=
OWNER_API_TOKEN=
BACKEND_TIMEOUT_MS=8000
# Server-only bearer for the backend /api/admission shared Redis counters.
# Must match Heroku RATE_LIMIT_SECRET; independent from every owner credential.
# No Vercel Firewall rule IDs, plan upgrade or frontend Redis URL is needed.
# Random 32-256 printable non-space ASCII; keep in deployment secret managers.
RATE_LIMIT_SECRET=
# Server-only token from a PUBLIC Vercel Blob store connected to this frontend.
# Never prefix with PUBLIC_. Public uploaded images are accessible by their URL.
BLOB_READ_WRITE_TOKEN=

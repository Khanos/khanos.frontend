# Public URL only: credentials, query strings and fragments are forbidden.
# Supply this in both build and runtime environments. HTTPS in production.
PUBLIC_BACKEND_API_URL=https://khanos-backend.herokuapp.com/api/
# Server-only secrets. Owner password is separate from the backend token.
URL_ADMIN_USERNAME=
URL_ADMIN_PASSWORD=
OWNER_API_TOKEN=
BACKEND_TIMEOUT_MS=8000

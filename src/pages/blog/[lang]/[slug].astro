---
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import BlogMetadata from '../../../components/BlogMetadata.astro';
import BlogList from '../../../components/BlogList.astro';
import { getBlogPost, getBlogPage, blogAsset, blogCacheControl } from '../../../services/blog';
import type { BlogPostSummary } from '../../../types/blog';
import { ApiRequestError } from '../../../services/api';
import { renderBlog } from '../../../utils/blog-render';
import '../../../styles/blog-content.css';
export const prerender = false;
const { lang, slug } = Astro.params;
if (!['en', 'es'].includes(lang || '') || !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug || '')) return new Response('Not found', { status: 404 });
let post;
try { post = await getBlogPost(`${lang}/${slug}`); }
catch (error) {
  const missing = error instanceof ApiRequestError && error.status === 404;
  return new Response(missing ? 'Not found' : 'Article temporarily unavailable', { status: missing ? 404 : 503, headers: { 'Cache-Control': 'no-store' } });
}
Astro.response.headers.set('Cache-Control', blogCacheControl);
const html = renderBlog(post.content, { article: true });
const cover = post.coverImage ? blogAsset(post.coverImage) : '';
let related: BlogPostSummary[] = [];
if (post.categories.length) {
  try {
    const candidates = (await getBlogPage(post.language, 1, 6, 'publishedAt')).data;
    related = candidates.filter(candidate => candidate.slug !== post.slug && candidate.categories.some(category => post.categories.includes(category))).slice(0, 2);
  } catch { /* Related reading is optional; keep the article available. */ }
}
const canonical = new URL(`/blog/${post.slug}`, Astro.site || Astro.url.origin).href;
const schema = {
  '@context': 'https://schema.org', '@type': 'BlogPosting',
  headline: post.title, description: post.excerpt || post.title,
  url: canonical, mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  inLanguage: post.language, datePublished: post.publishedAt, dateModified: post.updatedAt,
  ...(cover ? { image: cover } : {}),
  ...(!post.anonymous && post.author ? { author: { '@type': 'Person', name: post.author } } : {}),
  ...(post.categories.length ? { articleSection: post.categories } : {}),
};
const back = lang === 'es' ? 'Volver a Artículos' : 'Back to Writing';
---
<Layout title={post.title} description={post.excerpt || post.title} anonymous={post.anonymous} authorName={post.author}
  article language={post.language} socialImage={cover || undefined} writing>
  <Fragment slot="head">
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <meta property="article:published_time" content={post.publishedAt} />
    <meta property="article:modified_time" content={post.updatedAt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </Fragment>
  <main id="main-content" tabindex="-1" class="portfolio-main journal-main">
    <div class="journal-container">
      <article class="journal-article">
        <header class="journal-article-header">
          <a class="journal-link journal-back" href={`/blog?lang=${lang}`}><span aria-hidden="true">←</span> {back}</a>
          <p class="section-kicker"><span>05 /</span> {lang === 'es' ? 'NOTAS DE CAMPO' : 'NOTES FROM THE FIELD'}</p>
          <h1>{post.title}</h1>
          {post.excerpt && <p class="journal-intro">{post.excerpt}</p>}
          <BlogMetadata post={post} author />
        </header>
        {cover && <div class="journal-hero">
          <Image src={cover} alt={post.title} width={1280} height={720} widths={[390, 768, 1280]}
            sizes="(min-width: 1440px) 1280px, 92vw" format="webp" loading="eager" fetchpriority="high" />
        </div>}
        <div class="journal-prose blog-content prose dark:prose-invert" set:html={html} />
        <footer class="journal-article-footer"><a class="journal-link" href={`/blog?lang=${lang}`}>← {back}</a></footer>
      </article>
      {related.length > 0 && <section class="journal-related" aria-labelledby="related-title">
        <p class="section-kicker">{lang === 'es' ? 'SIGUE EXPLORANDO' : 'KEEP EXPLORING'}</p>
        <h2 id="related-title" class="section-title">{lang === 'es' ? 'Artículos relacionados' : 'Related writing'}</h2>
        <BlogList posts={related} heading="h3" />
      </section>}
    </div>
  </main>
</Layout>

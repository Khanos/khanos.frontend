---
import { Image } from "astro:assets";
import Layout from "../../../layouts/Layout.astro";
import SectionContainer from "../../../components/SectionContainer.astro";
import { getBlogPost, blogAsset, blogCacheControl } from "../../../services/blog";
import { ApiRequestError } from "../../../services/api";
import { renderBlog } from "../../../utils/blog-render";
import "../../../styles/blog-content.css";
import LinkInline from "../../../components/LinkInline.astro";

export const prerender = false;
const { lang, slug } = Astro.params;
if (!['en', 'es'].includes(lang || '') || !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug || '')) return new Response('Not found', { status: 404 });
let post;
try { post = await getBlogPost(`${lang}/${slug}`); }
catch (error) {
  const missing = error instanceof ApiRequestError && error.status === 404;
  return new Response(missing ? 'Not found' : 'Article temporarily unavailable', { status: missing ? 404 : 503, headers: { 'Cache-Control': 'no-store' } });
}
Astro.response.headers.set('Cache-Control', blogCacheControl);
const formattedDate = post.displayDate || new Intl.DateTimeFormat(lang, { timeZone: 'UTC' }).format(new Date(post.publishedAt!));
const byline = post.anonymous ? formattedDate : `${post.author} . ${formattedDate}`;
const html = renderBlog(post.content);
---

<Layout
  title={post.title}
  description={post.excerpt || byline}
  anonymous={post.anonymous}
  article
  language={post.language}
  socialImage={blogAsset(post.coverImage)}
>
  <main class="px-4">
    <SectionContainer id={post.title.trim()} class="py-16 md:py-36">
      <div class="text-3xl text-black/80 dark:text-white mb-4 font-semibold inline-block">
        {post.title}
      </div>
      <div class="text-medium text-black/80 dark:text-white mb-4 font-semibold inline-block">
        {byline}
      </div>
      <Image
        src={blogAsset(post.coverImage)}
        alt={post.title}
        width={900}
        height={900 / 1.5}
        format="webp"
        class="rounded-2xl shadow-xl mb-6 aspect-thumbnail object-cover"
      />
      <div class="blog-content prose dark:prose-invert min-w-full" set:html={html} />
      <div class="mt-10 text-right">
        <LinkInline 
          href={`/blog?lang=${lang}`}
          aria-label={lang === 'es' ? 'Volver a la lista de artículos' : 'Go back to the entries list'}
        >
          {lang === 'es' ? 'Volver' : 'Go back'}
        </LinkInline>
      </div>
    </SectionContainer>
  </main>
</Layout>

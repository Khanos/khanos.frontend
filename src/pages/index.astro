---
import Layout from "../layouts/Layout.astro"
import AboutMe from "../components/AboutMe.astro"
import Briefcase from "../components/icons/Briefcase.astro"
import Lab from "../components/icons/Lab.astro"
import CodeIcon from "../components/icons/Code.astro"
import Laboratory from "../components/Laboratory.astro"
import Experience from "../components/Experience.astro"
import ProfileCheck from "../components/icons/ProfileCheck.astro"
import Projects from "../components/Projects.astro"
import SectionContainer from "../components/SectionContainer.astro"
import LatestWriting from "../components/LatestWriting.astro"
import Hero from "../components/Hero.astro"
import { useTranslations } from '../i18n/utils';

type tLang = (str: any) => any;

const lang = Astro.url.searchParams.get("lang") === "es" ? "es" : "en";
const t:tLang = useTranslations(lang);
---

<Layout
  title={t('layouts').home.title}
  description={t('layouts').home.description}
>
  <main class="px-4">
    <SectionContainer id="home" class="pt-28 pb-16 md:pt-36 md:pb-24">
      <Hero />
    </SectionContainer>
    <div class="space-y-16 md:space-y-24">
      <LatestWriting lang={lang} />
      <SectionContainer id="lab">
        <h2
          class="flex items-center mb-3 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white"
        >
          <Lab class="size-7 shrink-0 dark:fill-white" aria-hidden="true" />
          {t('sections').lab.title}
        </h2>
        <p class="mb-6 max-w-2xl leading-relaxed text-gray-600 dark:text-gray-400">{t('sections').lab.label}</p>
        <Laboratory lang={lang} />
      </SectionContainer>

      <SectionContainer id="experience">
        <h2
          class="flex items-center mb-6 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white"
        >
          <Briefcase class="size-7 shrink-0" aria-hidden="true" />
          {t('sections').exp.title}
        </h2>
        <Experience />
      </SectionContainer>

      <SectionContainer id="projects">
        <h2
          class="flex items-center mb-6 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white"
        >
          <CodeIcon class="size-7 shrink-0" aria-hidden="true" />
          {t('sections').projects.title}
        </h2>
        <Projects />
      </SectionContainer>

      <SectionContainer id="about">
        <h2
          class="flex items-center mb-6 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white"
        >
          <ProfileCheck class="size-7 shrink-0" aria-hidden="true" />
          {t('sections').about.title}
        </h2>
        <AboutMe />
      </SectionContainer>
    </div>
  </main>
</Layout>

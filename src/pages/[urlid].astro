---
import { resolveShortUrl } from '../server/shortUrl';
import { normalizedCode } from '../services/contracts';
import { ApiRequestError } from '../services/api';

type UrlId = Record<string, string | undefined>;

const { urlid } : UrlId = Astro.params;
const redirect = (location: string) => {
  const response = Astro.redirect(location);
  response.headers.set('Cache-Control', 'no-store');
  return response;
};

if (!urlid || normalizedCode(urlid) === null) {
  return redirect('/');
} else {
  try {
    const urlData = await resolveShortUrl(urlid, Astro.request);
    return redirect(urlData.original_url);
  } catch (error) {
    if (error instanceof ApiRequestError && [400, 404].includes(error.status)) return redirect('/');
    const status = error instanceof ApiRequestError && [429, 502].includes(error.status) ? error.status : 503;
    const headers = new Headers({ 'Content-Type': 'text/plain; charset=utf-8', 'Cache-Control': 'no-store' });
    if (status === 429 && error instanceof ApiRequestError && error.retryAfter !== undefined) headers.set('Retry-After', String(error.retryAfter));
    return new Response(status === 429 ? 'Too many short-link requests. Please try again later.' : 'Short link temporarily unavailable. Please try again.', { status, headers });
  }
}
---

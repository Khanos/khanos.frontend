---
import { getLang } from '../i18n/utils';
import { ui } from '../i18n/ui';
import type { ProfessionalExperience } from '../types';

interface Props extends ProfessionalExperience { lang?: 'en' | 'es' }
const { lang = getLang(), title, company, description, link, linkLabel, date, context, current = false } = Astro.props;
---

<article class:list={['experience-entry', { 'experience-current': current }]}>
  <div class="experience-identity">
    {current && <p class="experience-status">{ui[lang].sections.exp.currentRole}</p>}
    <h4 class="experience-role">{title}</h4>
    <p class="experience-company">{company}</p>
    {context && <p class="experience-context">{context}</p>}
    <p class="experience-date">{date}</p>
  </div>
  <div class="experience-contribution">
    <p>{description}</p>
    {link && <a class="experience-link" href={link}>
      {linkLabel ?? company}<span aria-hidden="true">↗</span>
    </a>}
  </div>
</article>

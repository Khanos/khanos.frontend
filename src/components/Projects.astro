---
import { Image } from 'astro:assets';
import { getLang } from '../i18n/utils';
import { ui } from '../i18n/ui';
import { TAGS } from '../data/tags.astro';
interface Props { lang?: 'en' | 'es' }
const { lang = getLang() } = Astro.props;
const labels = ui[lang].sections.projects;
const projects = labels.projectsList.filter(project => project.caseStudy);
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/img/projects/*.{jpeg,jpg,png,gif}');
---
<div class="engineering-work">
  {projects.map(({ image, imageAlt, title, caseStudy, tags, link, github }, index) => (
    <article class:list={['engineering-case', { reverse: index % 2 !== 0 }]}>
      <figure class="case-visual">
        <div class="image-toolbar" aria-hidden="true"><span class="window-dots"><i></i><i></i><i></i></span><span>{caseStudy?.category}</span><span>0{index + 1}</span></div>
        <div class="image-stage">
          {images[image] && <Image src={images[image]()} alt={imageAlt} width={1000} widths={[480, 800, 1200]} sizes="(max-width: 899px) 92vw, (max-width: 1408px) 52vw, 700px" format="webp" loading="lazy" />}
        </div>
        <figcaption><span>{labels.archiveImage}</span><span aria-hidden="true">↗</span></figcaption>
      </figure>
      <div class="case-copy">
        <p class="case-index"><span>0{index + 1}</span> / {caseStudy?.category}</p>
        <h3>{title}</h3>
        <p class="case-summary">{caseStudy?.summary}</p>
        <ul class="case-tech" aria-label={labels.technology}>
          {tags.filter(tag => !['github', 'facebook', 'linkedin', 'twitter', 'ganalytics', 'gads'].includes(tag)).map(key => {
            const tag = TAGS[key as keyof typeof TAGS];
            return tag && <li>{tag.name}</li>;
          })}
        </ul>
        <div class="case-links">
          {link && <a href={link}>{labels.projectLink}<span aria-hidden="true">↗</span></a>}
          {github && <a href={github}>{labels.codeLink}<span aria-hidden="true">↗</span></a>}
        </div>
      </div>
      <dl class="case-narrative">{caseStudy && (['problem', 'contribution', 'impact'] as const).map(key => <div><dt>{labels[key]}</dt><dd>{caseStudy[key]}</dd></div>)}</dl>
    </article>
  ))}
</div>
<style>
  .engineering-work { display: grid; gap: var(--folio-space-section); }
  .engineering-case { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); align-items: center; gap: var(--folio-space-7) var(--folio-space-8); }
  .engineering-case.reverse { grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); }
  .reverse .case-visual { grid-column: 2; grid-row: 1; }
  .reverse .case-copy { grid-column: 1; grid-row: 1; }
  .case-visual { min-width: 0; position: relative; border: 1px solid var(--folio-line); background: var(--folio-surface); }
  .image-toolbar { display: flex; align-items: center; justify-content: space-between; gap: var(--folio-space-3); padding: var(--folio-space-3) var(--folio-space-4); border-bottom: 1px solid var(--folio-line); font: var(--folio-text-meta)/1.5 var(--folio-mono); color: var(--folio-muted); }
  .window-dots { display: flex; gap: var(--folio-space-1); }
  .window-dots i { width: 5px; height: 5px; border-radius: 50%; background: var(--folio-muted); }
  .window-dots i:first-child { background: var(--folio-accent); }
  .image-stage { padding: var(--folio-space-8) var(--folio-space-6); background-color: #d6cf4e; background-image: linear-gradient(135deg, rgb(255 255 255 / .12) 25%, transparent 25%, transparent 50%, rgb(255 255 255 / .12) 50%, rgb(255 255 255 / .12) 75%, transparent 75%); background-size: 5px 5px; overflow: hidden; }
  .reverse .image-stage { background-color: #a1b8ae; }
  .image-stage :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 1.76; object-fit: cover; object-position: top; border-radius: .2rem; box-shadow: 0 20px 35px -15px rgb(0 0 0 / .5); transform: perspective(1100px) rotateY(-4deg) rotateX(2deg); transition: transform 600ms cubic-bezier(.2,.7,.2,1); }
  .reverse .image-stage :global(img) { transform: perspective(1100px) rotateY(4deg) rotateX(2deg); }
  .case-visual:hover :global(img) { transform: perspective(1100px) rotateY(0) rotateX(0) translateY(-3px); }
  figcaption { display: flex; align-items: center; justify-content: space-between; gap: var(--folio-space-4); padding: var(--folio-space-3) var(--folio-space-4); color: var(--folio-muted); font-size: var(--folio-text-support); line-height: 1.5; }
  .case-copy { min-width: 0; }
  .case-index { font: var(--folio-text-meta)/1.5 var(--folio-mono); color: var(--folio-muted); }
  .case-index span { color: var(--folio-accent); }
  h3 { margin-top: var(--folio-space-4); font-size: var(--folio-text-project); line-height: var(--folio-leading-heading); font-weight: 550; letter-spacing: var(--folio-tracking-heading); text-wrap: balance; }
  .case-summary { max-width: 65ch; margin-top: var(--folio-space-5); font-size: var(--folio-text-body); line-height: var(--folio-leading-body); color: var(--folio-secondary); }
  .case-tech { display: flex; flex-wrap: wrap; gap: var(--folio-space-2); margin-top: var(--folio-space-5); }
  .case-tech li { padding: var(--folio-space-1) var(--folio-space-2); border: 1px solid var(--folio-line); color: var(--folio-secondary); font-size: var(--folio-text-meta); line-height: 1.5; }
  .case-narrative { grid-column: 1 / -1; padding-top: var(--folio-space-6); border-top: 1px solid var(--folio-line); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--folio-space-7); }
  dt { font-size: var(--folio-text-support); font-weight: 650; color: var(--folio-accent); margin-bottom: var(--folio-space-2); }
  dd { max-width: 65ch; font-size: var(--folio-text-body); line-height: var(--folio-leading-body); color: var(--folio-secondary); }
  .case-links { display: flex; flex-wrap: wrap; gap: var(--folio-space-4); margin-top: var(--folio-space-5); }
  .case-links a { display: inline-flex; align-items: center; gap: var(--folio-space-4); min-height: 44px; font-size: var(--folio-text-support); font-weight: 600; text-decoration: underline; text-decoration-color: var(--folio-accent); text-underline-offset: .3em; }
  .case-links a:hover { color: var(--folio-accent); }
  a:focus-visible { outline: 2px solid var(--folio-accent); outline-offset: 5px; }
  @media (max-width: 899px) {
    .engineering-case, .engineering-case.reverse { grid-template-columns: minmax(0, 1fr); gap: var(--folio-space-6); }
    .reverse .case-visual, .reverse .case-copy { grid-column: auto; grid-row: auto; }
    .case-copy { max-width: 70ch; }
    .case-narrative { grid-template-columns: minmax(0, 1fr); gap: var(--folio-space-5); }
    .image-stage { padding: var(--folio-space-7) var(--folio-space-4); }
  }
  @media (prefers-reduced-motion: reduce) { .image-stage :global(img) { transition: none; transform: none !important; } }
</style>

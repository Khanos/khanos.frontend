---
import { Image } from 'astro:assets';
import type { LabProject } from '../types';
import { ui } from '../i18n/ui';
interface Props { project: LabProject; lang: 'en' | 'es' }
const { project, lang } = Astro.props;
const lab = ui[lang].sections.lab;
const external = (project.link ?? project.github)?.startsWith('https://');
---
<div class="preview">
  {typeof project.image === 'string' ? (
    <img src={project.image} alt={project.imageAlt} loading="lazy" decoding="async" width="1280" height="720" />
  ) : (
    <Image class="tool-cover" src={project.image} width={640} format="webp" alt={project.imageAlt} loading="lazy" decoding="async" />
  )}
</div>

<div class="experiment-copy">
  <div class="meta-row">
    <span class="status">{project.status}</span>
    <span class="source">{project.showcase ? lab.showcase.view : external ? 'GitHub' : lab.openTool}</span>
  </div>

  <h3>{project.title}</h3>
  <p>{project.description}</p>

  <ul class="tags">
    {project.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  {project.showcase ? <slot name="action" /> : <span class="action">
    {project.linkLabel}
    <span aria-hidden="true">{external ? '↗' : '→'}</span>
  </span>}
</div>

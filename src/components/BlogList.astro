---
import type { BlogPostSummary } from '../types/blog';
import Post from './Post.astro';
interface Props { posts: BlogPostSummary[]; featureLatest?: boolean; heading?: 'h2' | 'h3' }
const { posts, featureLatest = false, heading = 'h2' } = Astro.props;
const [featured, ...remaining] = posts;
const grid = featureLatest ? remaining : posts;
---
{featureLatest && featured && <Post post={featured} featured />}
{grid.length > 0 && <div class="journal-grid">{grid.map(post => <Post post={post} heading={heading} />)}</div>}

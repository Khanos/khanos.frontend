---
import { Image } from 'astro:assets';
import { getLang } from '../i18n/utils';
import { ui } from '../i18n/ui';
import LabGithubImage from '../assets/img/lab-github.png';
import LabSvgToComponentImage from '../assets/img/lab-svg-to-component.png';
import LabUrlImage from '../assets/img/lab-url.png';
const lab = ui[getLang()].sections.lab;
const experiments = [
  { ...lab.svgToComponent, image: LabSvgToComponentImage, href: '/svgToComponent' },
  { ...lab.github, image: LabGithubImage, href: '/github' },
  { ...lab.url, image: LabUrlImage, href: '/url' },
];
---
<div class="lab-grid">
  {experiments.map(experiment => <article class="experiment">
    <a href={experiment.href}>
      <div class="preview">
        <Image src={experiment.image} width={480} height={300} format="webp" alt={experiment.imgAlt} loading="lazy" />
      </div>
      <div class="experiment-copy">
        <h3>{experiment.title}</h3>
        <p>{experiment.description}</p>
        <span class="action">{experiment.linkLabel} <span aria-hidden="true">→</span></span>
      </div>
    </a>
  </article>)}
</div>
<style>
  .lab-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
  .experiment { min-width: 0; border: 1px solid rgb(120 120 130 / .2); border-radius: 1rem; background: rgb(120 120 130 / .06); overflow: hidden; transition: border-color 180ms, transform 180ms, box-shadow 180ms; }
  .experiment:hover { transform: translateY(-3px); border-color: rgb(248 0 174 / .45); box-shadow: 0 10px 30px rgb(248 0 174 / .06); }
  a { display: flex; height: 100%; flex-direction: column; }
  a:focus-visible { outline: 2px solid #F800AE; outline-offset: -4px; border-radius: 1rem; }
  .preview { aspect-ratio: 16 / 10; overflow: hidden; }
  img { width: 100%; height: 100%; object-fit: cover; transition: transform 180ms; }
  .experiment:hover img { transform: scale(1.02); }
  .experiment-copy { padding: 1.1rem; flex: 1; display: flex; flex-direction: column; }
  h3 { font-size: 1.05rem; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
  p { margin-top: .65rem; color: #62626e; font-size: .875rem; line-height: 1.6; }
  .action { padding-top: 1.25rem; margin-top: auto; color: #a60075; font-size: .875rem; font-weight: 600; }
  :global(.dark) p { color: #acacb8; }
  :global(.dark) .action { color: #ff70d4; }
  @media (min-width: 640px) { .lab-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .lab-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (prefers-reduced-motion: reduce) { .experiment, img { transition: none; } .experiment:hover, .experiment:hover img { transform: none; } }
</style>

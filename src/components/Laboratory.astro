---
import { getLang } from '../i18n/utils';
import { ui } from '../i18n/ui';

const lab = ui[getLang()].sections.lab;
const experiments = [
  {
    ...lab.ovitals,
    image: '/lab/ovitals.svg',
    href: 'https://github.com/Khanos/ovitals',
    tags: ['Python', 'GTK 4', 'Linux'],
  },
  {
    ...lab.wallapibara,
    image: '/lab/wallapibara.svg',
    href: 'https://github.com/Khanos/wallapibara',
    tags: ['Next.js', 'TypeScript', 'Generative UI'],
  },
  {
    ...lab.pngToSvg,
    image: '/lab/png-to-svg.svg',
    href: 'https://github.com/Khanos/png-to-svg',
    tags: ['Python', 'CLI', 'Asset tooling'],
  },
  {
    ...lab.localImageStudio,
    image: '/lab/local-image-studio.svg',
    href: 'https://github.com/Khanos/local-image-studio',
    tags: ['Next.js', 'ComfyUI', 'Local AI'],
  },
];
---

<div class="lab-grid">
  {experiments.map((experiment) => (
    <article class="experiment">
      <a href={experiment.href} target="_blank" rel="noreferrer">
        <div class="preview">
          <img src={experiment.image} alt={experiment.imgAlt} loading="lazy" />
        </div>

        <div class="experiment-copy">
          <div class="meta-row">
            <span class="status">{experiment.status}</span>
            <span class="source">GitHub</span>
          </div>

          <h3>{experiment.title}</h3>
          <p>{experiment.description}</p>

          <div class="tags" aria-label="Technologies">
            {experiment.tags.map((tag) => <span>{tag}</span>)}
          </div>

          <span class="action">
            {experiment.linkLabel}
            <span aria-hidden="true">↗</span>
          </span>
        </div>
      </a>
    </article>
  ))}
</div>

<style>
  .lab-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }

  .experiment {
    min-width: 0;
    border: 1px solid rgb(120 120 130 / .2);
    border-radius: 1.15rem;
    background: rgb(120 120 130 / .055);
    overflow: hidden;
    transition: border-color 180ms, transform 180ms, box-shadow 180ms;
  }

  .experiment:hover {
    transform: translateY(-4px);
    border-color: rgb(248 0 174 / .42);
    box-shadow: 0 16px 38px rgb(20 20 30 / .10);
  }

  a {
    display: flex;
    height: 100%;
    flex-direction: column;
  }

  a:focus-visible {
    outline: 2px solid #F800AE;
    outline-offset: -4px;
    border-radius: 1rem;
  }

  .preview {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid rgb(120 120 130 / .14);
    background: #0d1119;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .experiment:hover img {
    transform: scale(1.015);
  }

  .experiment-copy {
    padding: 1.15rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    margin-bottom: .75rem;
  }

  .status,
  .source {
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .status {
    color: #a60075;
  }

  .source {
    color: #888894;
  }

  h3 {
    font-size: 1.1rem;
    font-weight: 650;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  p {
    margin-top: .6rem;
    color: #62626e;
    font-size: .875rem;
    line-height: 1.6;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
    margin-top: 1rem;
  }

  .tags span {
    border: 1px solid rgb(120 120 130 / .18);
    border-radius: 999px;
    padding: .25rem .5rem;
    color: #73737f;
    background: rgb(120 120 130 / .055);
    font-size: .68rem;
    font-weight: 600;
  }

  .action {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    padding-top: 1.2rem;
    margin-top: auto;
    color: #a60075;
    font-size: .875rem;
    font-weight: 650;
  }

  :global(.dark) p {
    color: #acacb8;
  }

  :global(.dark) .status,
  :global(.dark) .action {
    color: #ff70d4;
  }

  :global(.dark) .source,
  :global(.dark) .tags span {
    color: #9c9ca8;
  }

  @media (min-width: 640px) {
    .lab-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .experiment,
    img {
      transition: none;
    }

    .experiment:hover,
    .experiment:hover img {
      transform: none;
    }
  }
</style>

---
import ConfigMenu from "./configMenu/ConfigMenu"
import { getLang, useTranslations } from '../i18n/utils';

type tLang = (str: any) => any;

const lang = getLang();
const t:tLang = useTranslations(lang);

const navItems = [
  {
    title: t('nav').home.title,
    label: t('nav').home.label,
    url: "/#home",
  },
  {
    title: t('nav').writing.title,
    label: t('nav').writing.label,
    url: "/#writing",
  },
  {
    title: t('nav').lab.title,
    label: t('nav').lab.label,
    url: "/#lab",
  },
  {
    title: t('nav').exp.title,
    label: t('nav').exp.label,
    url: "/#experience",
  },
  {
    title: t('nav').projects.title,
    label: t('nav').projects.label,
    url: "/#projects",
  },
  {
    title: t('nav').about.title,
    label: t('nav').about.label,
    url: "/#about",
  },
]
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-2"
>
  <nav
    class="flex flex-wrap px-3 text-sm font-medium rounded-full text-gray-600 bg-gray-200/60 dark:bg-black/60  dark:text-gray-200 justify-center items-center"
    id="nav-menu"
  >
  {
    navItems.map((link) => (
      <a
      class="relative block px-2 py-2 hover:scale-110 transition"
      aria-label={link.title}
      data-section-link={link.label}
      href={lang === "es" ? link.url.replace("/#", "/?lang=es#") : link.url}
      >
      {link.title}
      </a>
      ))
    }
    <ConfigMenu lang={lang} client:only="react" />
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-section-link]"));
    const sections = links.map(link => document.getElementById(link.dataset.sectionLink!))
      .filter((section): section is HTMLElement => section !== null);
    const updateActive = () => {
      const reached = sections.filter(section => section.getBoundingClientRect().top <= window.innerHeight * .35);
      const active = reached[reached.length - 1] || sections[0];
      links.forEach(link => {
        const selected = link.dataset.sectionLink === active?.id;
        link.classList.toggle("text-[#F800AE]", selected);
        if (selected) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    };
    let scheduled = false;
    const onScroll = () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(() => { updateActive(); scheduled = false; });
    };
    updateActive();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    document.addEventListener("astro:before-swap", () => {
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onScroll);
    }, { once: true });
  });
</script>

<style>
  nav { max-width: calc(100% - 1rem); backdrop-filter: blur(12px); }
  nav a:focus-visible { outline: 2px solid #F800AE; outline-offset: -2px; border-radius: 9999px; }
  nav a[aria-current] { background: rgb(248 0 174 / .1); border-radius: 9999px; }
  @media (max-width: 639px) { nav { padding: .25rem; font-size: .75rem; } nav a { padding: .5rem; } }
  @media (prefers-reduced-motion: reduce) { nav { animation: none !important; } nav a { transition: none; } nav a:hover { transform: none; } }
  nav {
    animation: nav-shadown 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  @keyframes nav-shadown {
    to {
      @apply shadow-lg ring-1 backdrop-blur ring-white/10;
    }
  }
</style>
---
import { Image } from 'astro:assets';
import type { BlogPostSummary } from '../types/blog';
import { blogAsset } from '../services/blog';
import { ui } from '../i18n/ui';
import BlogMetadata from './BlogMetadata.astro';
interface Props { post: BlogPostSummary; featured?: boolean; heading?: 'h2' | 'h3' }
const { post, featured = false, heading: Heading = 'h2' } = Astro.props;
const labels = ui[post.language].sections.writing;
const cover = post.coverImage ? blogAsset(post.coverImage) : '';
---
<article class:list={['journal-card', { 'journal-featured': featured, 'journal-text-only': !cover }]}>
  {cover && <a class="journal-image" href={`/blog/${post.slug}`} tabindex="-1" aria-hidden="true">
    <Image src={cover} alt={post.title} width={featured ? 1200 : 640} height={featured ? 675 : 360}
      widths={featured ? [480, 800, 1200] : [320, 480, 640]} sizes={featured ? '(min-width: 900px) 55vw, 100vw' : '(min-width: 1100px) 30vw, (min-width: 700px) 45vw, 100vw'}
      format="webp" loading={featured ? 'eager' : 'lazy'} fetchpriority={featured ? 'high' : 'auto'} />
  </a>}
  <div class="journal-card-copy">
    {featured && <p class="section-kicker">{post.language === 'es' ? 'LA ÚLTIMA NOTA' : 'LATEST NOTE'}</p>}
    <BlogMetadata post={post} />
    <Heading class="journal-card-title"><a href={`/blog/${post.slug}`}>{post.title}</a></Heading>
    {post.excerpt && <p class="journal-excerpt">{post.excerpt}</p>}
    <a class="journal-link" href={`/blog/${post.slug}`} aria-label={`${labels.readArticle}: ${post.title}`}>{labels.readArticle} <span aria-hidden="true">↗</span></a>
  </div>
</article>
